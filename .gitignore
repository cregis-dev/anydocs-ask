.vscode/
.idea/
.DS_Store
*.swp

# Tests / coverage
coverage/
.nyc_output/

# Python tooling used by the optional offline Ragas evaluator
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/*.pyc
**/*.egg-info/
ragas-reports/

# SQLite local artifacts (in case tests / fixtures drop one in repo root)
*.db
*.db-journal
*.db-wal
*.db-shm

# Transformers.js / model cache (when @xenova/transformers drops into project)
.cache/

# Local test scratch (screenshots, scratch scripts, etc.)
tests/.tmp/
